{
    "manifest_version": 3,
    "name": "店客多",
    "description": "店客多品牌连锁账号绑定及订购用途",
    "version": "0.3.5",
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_title": "popup",
        "default_icon": {
            "48": "assets/icon/logo48x48.png",
            "128": "assets/icon/logo128x128.png"
        },
        "default_popup": "popup.html"
    },
    "icons": {
        "48": "assets/icon/logo48x48.png",
        "128": "assets/icon/logo128x128.png"
    },
    "content_scripts": [
        {
            "js": ["js/content.js"],
            "css": [],
            "matches": ["*://*.meituan.com/*", "*://*.diankeduo.net/*", "*://*.ele.me/*", "*://*.jddj.com/*"],
            "run_at": "document_idle"
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "web_accessible_resources": [
        {
            "resources": ["fonts/*", "js/*", "css/*", "img/*"],
            "matches": ["*://*.meituan.com/*", "*://*.diankeduo.net/*", "*://*.ele.me/*", "*://*.jddj.com/*"]
        }
    ],

    "permissions": [
        "contextMenus",
        "cookies",
        "tabs",
        "storage",
        "downloads",
        "unlimitedStorage",
        "downloads",
        "browsingData",
        "scripting",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.meituan.com/*",
        "*://*.diankeduo.net/*",
        "*://*.ele.me/*",
        "*://*.jddj.com/*",
        "<all_urls>"
    ]
}
